# Copie para .env e preencha. .env NUNCA vai para o Git.

# API
BGP_API_PORT=8080
BGP_API_KEY=

# Sessão BGP (eBGP com MD5)
BGP_LOCAL_ASN=
BGP_NEIGHBOR_ADDR=
BGP_NEIGHBOR_ASN=
BGP_MD5=

# Limites
BGP_MAX_PREFIXES=500
BGP_MAX_PROFILES=50

# Caminho do SQLite (volume Docker)
BGP_DB_PATH=/data/bgpadvert.db

# Retenção (dias)
BGP_AUDIT_RETENTION_DAYS=90
BGP_APPLOG_RETENTION_DAYS=14

# Limites de container (usados pelo compose)
CPU_LIMIT=1
MEM_LIMIT=512M
